{
    "name": "krugozor/cover",
    "description": "PHP Array Object (PHP collection)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cover array",
        "php array cover",
        "array object",
        "php array object",
        "php array collection",
        "ArrayObject",
        "array wrapper",
        "php array wrapper",
        "php collection",
        "php array",
        "array"
    ],
    "require": {
        "php": ">=8.0",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "authors": [
        {
            "name": "Vasiliy Makogon",
            "homepage": "https://github.com/Vasiliy-Makogon/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Krugozor\\Cover\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Krugozor\\Cover\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}